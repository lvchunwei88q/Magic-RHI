    "version": "0.2.0",
    "configurations": [
        {
            "name": "运行选定的测试程序",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceRoot}/Binary/Debug/${input:pickExecutable}",
            "args": [],
            "cwd": "${workspaceRoot}",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "pickExecutable",
            "type": "pickString",
            "description": "选择要运行的测试程序:",
            "options": [
                "HelloTriangleTest.exe",
            ]
        }
    ]

    // ============================================================
    // 此配置依赖以下插件才能正常工作：
    //    - kylinideteam.cmake-intellisence
    //    - vadimcn.vscode-lldb
    //    - franneck94.c-cpp-runner
    //    - nilssoderman.batch-runner
    // ============================================================
}