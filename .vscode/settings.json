{
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/out"
    ],
    "terminal.integrated.profiles.windows": {
        // Please set VSDEVCMD_PATH in your Windows user environment variables to the path of VsDevCmd.bat on your machine.
        "VS Dev CMD": {
            "path": "C:\\Windows\\System32\\cmd.exe",
            "args": [
                "/k",
                "call %VSDEVCMD_PATH% -arch=x64"
            ],
            "icon": "terminal-cmd"
        }
    }
}